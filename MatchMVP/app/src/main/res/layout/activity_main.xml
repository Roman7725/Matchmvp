<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0A0118">

    <!-- JOIN SCREEN -->
    <LinearLayout
        android:id="@+id/joinScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MATCH MVP"
            android:textColor="#00F0FF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/nicknameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nickname_hint"
            android:textColorHint="#88FFFFFF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/phoneInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/phone_hint"
            android:inputType="phone"
            android:textColorHint="#88FFFFFF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/ageCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/age_check_label"
            android:textColor="#CCFFFFFF"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/badgeCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/badge_check_label"
            android:textColor="#CCFFFFFF"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/joinBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/join_button" />

    </LinearLayout>

    <!-- ROOM SCREEN -->
    <LinearLayout
        android:id="@+id/roomScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nearby_title"
            android:textColor="#00F0FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/peersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
