<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0B18">

    <!-- JOIN SCREEN -->
    <LinearLayout
        android:id="@+id/joinScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/langBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN / RU"
                android:textSize="12sp"
                android:textColor="#00E5FF"
                android:background="?android:attr/selectableItemBackground"/>
        </LinearLayout>

        <TextView
            android:id="@+id/titleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MATCH MVP"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#00E5FF"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/nicknameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Имя / Nickname"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/phoneInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Телефон / Phone number"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:inputType="phone"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email (опционально)"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="20dp"/>

        <CheckBox
            android:id="@+id/ageCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мне есть 18 лет / I am 18 or older"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <CheckBox
            android:id="@+id/badgeCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Показывать значок сообщества\nShow community badge"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/joinBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="ВОЙТИ В ЭФИР / JOIN BROADCAST"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#E0E0E0"/>

    </LinearLayout>

    <!-- ROOM SCREEN -->
    <LinearLayout
        android:id="@+id/roomScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/roomTitleTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Кто рядом / Nearby"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#00E5FF"/>

            <Button
                android:id="@+id/leaveBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выйти / Leave"
                android:textColor="#FF5252"
                android:textSize="13sp"
                android:background="?android:attr/selectableItemBackground"/>
        </LinearLayout>

        <!-- STATUS RADAR BAR -->
        <LinearLayout
            android:id="@+id/radarStatusLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:background="#1A00E5FF">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:indeterminate="true"/>

            <TextView
                android:id="@+id/radarStatusTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Поиск устройств рядом..."
                android:textColor="#00E5FF"
                android:textSize="12sp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/peersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </LinearLayout>

</FrameLayout>
